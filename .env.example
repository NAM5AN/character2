# Server-only Supabase credentials
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SECRET

# AI providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Admin page secret (not a user login)
ADMIN_SECRET=change-this-long-random-secret

# Used when hashing IPs for lightweight rate limiting
RATE_LIMIT_SALT=change-this-too
